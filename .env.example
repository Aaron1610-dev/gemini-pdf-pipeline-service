APP_NAME=gemini-pdf-pipeline-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8100
WORKSPACE_DIR=./workspace
OUTPUT_DIR=./output
LOG_DIR=./logs

GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=
# or:
# GEMINI_API_KEY_1=
# GEMINI_API_KEY_2=
