MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=data-ai-tra-cuu

ENABLE_KAGGLE=false
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_KERNEL_REF=dat261303/debug-cutlines-auto
KAGGLE_DATASET_ID=dat261303/kaggle-pack
KAGGLE_MAX_ATTEMPTS=3
KAGGLE_POLL_SECONDS=20
